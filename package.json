{
  "name": "claude-monitor",
  "displayName": "Claude Monitor",
  "description": "🇨🇳 Claude Code 实时状态栏监控 | 🇬🇧 Real-time status bar monitor for Claude Code — model, context, rate, TTFT, retry detection, multi-session",
  "version": "0.3.3",
  "publisher": "xuehun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuehun2/Claude-Code-Monitor.git"
  },
  "keywords": ["claude", "claude-code", "monitor", "status-bar", "ai"],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other", "Visualization"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeMonitor.showDashboard",
        "title": "Claude Monitor: Show Live Dashboard",
        "category": "Claude Monitor"
      },
      {
        "command": "claudeMonitor.selectSession",
        "title": "Claude Monitor: Select Session to Monitor",
        "category": "Claude Monitor"
      },
      {
        "command": "claudeMonitor.openTranscript",
        "title": "Claude Monitor: Open Transcript File",
        "category": "Claude Monitor"
      },
      {
        "command": "claudeMonitor.refresh",
        "title": "Claude Monitor: Refresh Now",
        "category": "Claude Monitor"
      }
    ],
    "configuration": {
      "title": "Claude Monitor",
      "properties": {
        "claudeMonitor.projectsDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the Claude Code projects directory (defaults to `~/.claude/projects`). Leave empty to use the default."
        },
        "claudeMonitor.contextLimit": {
          "type": "number",
          "default": 200000,
          "markdownDescription": "Model context window size in tokens, used to compute the context-usage percentage."
        },
        "claudeMonitor.refreshIntervalMs": {
          "type": "number",
          "default": 1000,
          "minimum": 250,
          "markdownDescription": "Poll interval (ms) for refreshing status from the transcript."
        },
        "claudeMonitor.retryThresholdMs": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "markdownDescription": "Legacy threshold (deprecated; retry detection is now log-driven)."
        },
        "claudeMonitor.statusBarAlignment": {
          "type": "string",
          "enum": ["left", "right"],
          "default": "right",
          "markdownDescription": "Status bar item alignment."
        },
        "claudeMonitor.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the live status bar item."
        },
        "claudeMonitor.maxHistoryRequests": {
          "type": "number",
          "default": 40,
          "minimum": 5,
          "markdownDescription": "How many recent requests to keep for the dashboard sparkline / history table."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "echo skip"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
